# Vision AI provider
# No provider is selected by default. Saved posts are exported without AI unless
# you set INSTAPULL_PROVIDER or run with --provider.
# INSTAPULL_PROVIDER=gemini

# Gemini Developer API through Google AI Studio
# Google documents API keys through AI Studio, but access can depend on account,
# region, project permissions, and billing/quota setup.
GEMINI_API_KEY=your_gemini_api_key_here

# You can also override the model.
# Default: gemini-2.5-flash-lite
# GEMINI_MODEL=gemini-2.5-flash-lite

# Gemini through Vertex AI
# This uses Google Cloud credentials instead of a simple API key. Use this only
# if you already prefer the Google Cloud setup path.
# GOOGLE_GENAI_USE_VERTEXAI=true
# GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# Ollama local vision model
# Requires Ollama running locally and a pulled vision model.
# Example setup: ollama pull qwen2.5vl
# INSTAPULL_PROVIDER=ollama
# OLLAMA_MODEL=qwen2.5vl
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_TIMEOUT_SECONDS=120

# Output folder
# Where your saved posts will be stored.
# You can also use the command option: instapull sync --output /path/to/folder
# INSTAPULL_OUTPUT_DIR=/path/to/your/folder

# Video analysis
# InstaPull uses a deterministic duration table.
# Examples: 10 seconds = 5 frames, 15 seconds = 6 frames, 30 seconds = 10 frames.
# Very long videos are capped to avoid unexpectedly large AI requests.
# INSTAPULL_VIDEO_SECONDS_PER_FRAME=2
# INSTAPULL_VIDEO_MAX_FRAMES=24
# Safety limit for temporary video downloads. Raise this if your saved videos are larger.
# INSTAPULL_MAX_VIDEO_MB=100
